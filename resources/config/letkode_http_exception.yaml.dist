letkode_http_exception:
    # Only requests whose path starts with this are handled. '' handles every path.
    path_prefix: /api

    # Set to false to not register the ExceptionListener (use your own).
    listener_enabled: true

    # Priority of the kernel.exception listener.
    listener_priority: 0

    # Validation failures whose violations ALL come from these constraints respond with the given
    # status instead of 422 (mixed or unmapped violations stay 422). Defaults, always present:
    #   Letkode\CommonBundle\Attribute\Constraint\UniqueField\UniqueField: 409
    #   Symfony\Bridge\Doctrine\Validator\Constraints\UniqueEntity: 409
    # Entries here are merged on top of the defaults; ~ disables a default.
    # validation:
    #     status_by_constraint:
    #         App\Validator\NotLocked: 423
    #         Letkode\CommonBundle\Attribute\Constraint\UniqueField\UniqueField: ~

# Per-environment override:
# when@dev:
#     letkode_http_exception:
#         listener_enabled: false
